@model List<LOAIFIGURE>

<form action="@Url.Action("TimKiem", "BanHang")" method="get" class="row g-3">
    <!-- Tên sản phẩm -->
    <!-- Từ khóa -->
    <div class="col-12 col-md-12">
        <label for="kw" class="form-label">Từ khóa</label>
        <input type="text" class="form-control" id="kw" name="kw" placeholder="Từ khóa...">
    </div>
    <!-- Chủ đề -->
    <div class="col-12 col-md-12">
        <label for="chude" class="form-label">Thể loại</label>
        <select id="chude" name="chude" class="form-select">
            <option value="" selected>-- Tất cả --</option>
            @foreach (var item in Model)
            {
                <option value="@item.MaLoai">@item.TenLoai</option>
            }


        </select>
    </div>
    <!-- Giá -->
    <div class="col-12 col-md-12">
        <span class="form-label d-block mb-1">Giá</span>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="0-1000000" id="g1" name="gia">
            <label class="form-check-label" for="g1">0–1.000.000 VNĐ</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="1100000-2000000" id="g2" name="gia">
            <label class="form-check-label" for="g2">1.100.000–2.000.000 VNĐ</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="2100000-4000000" id="g3" name="gia">
            <label class="form-check-label" for="g3">2.100.000–4.000.000 VNĐ</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value=">4000000" id="g4" name="gia">
            <label class="form-check-label" for="g4">Lớn hơn 4.000.000 VNĐ</label>
        </div>
    </div>

    <!-- Nút Search -->
    <div class="col-12">
        <button type="submit" class="btn btn-primary px-4">Tìm kiếm</button>
        <button type="reset" class="btn btn btn-danger">Xóa</button>
    </div>
</form>

