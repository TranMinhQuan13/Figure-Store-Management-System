@model DoAnQLFIGURE.FIGURE
@{
    ViewBag.Title = "Them";
    Layout = "~/Views/Shared/_LayoutPageAdmin.cshtml";
}

<h2>Thêm sản phẩm mới</h2>

@using (Html.BeginForm("CreateSubmit", "SanPham", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        
