@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin</title>
    <link href="~/Content/StyleSheet1.css" rel="stylesheet" />

</head>
<body>
    <header>
        <!-- HEADER -->
        <nav class="navbar navbar-expand-lg" style="background: linear-gradient(90deg, #1a1a2e, #252536);">
            <div class="container">
                <a class="navbar-brand text-white" href="@Url.Action("Welcome","admin")">Figure<span style="color:#ff3d00">Shop</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link text-light" href="@Url.Action("Welcome","admin")">Trang chủ</a></li>

                        <li class="nav-item"><a class="nav-link text-light" href="#">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="#">Liên hệ</a></li>
                    </ul>


                    @if (Session["TenNV"] != null)
                    {
                        <div class="navbar-nav ml-auto py-0">
                            <a href="#" class="nav-item nav-link text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-person-circle text-primary" viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                </svg>
                                @Session["TenNV"]
                            </a>


                        </div>
                        <div class="navbar-nav ml-auto py-0 text-primary">
                            <a href="@Url.Action("LogOut","Account")" class="nav-item nav-link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-person-circle text-primary" viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                </svg>
                                <span class="text-primary">Đăng xuất</span>
                            </a>
                        </div>
                    }
                   
                </div>
            </div>
        </nav>

        <!-- HEADER -->
    </header>
    <!-- HEADER -->
    <div>

        <main class="container site-main">

            @RenderBody()
        </main>
    </div>
    <!-- FOOTER -->
    <footer class="bg-dark text-light py-4">
        <div class="container d-flex justify-content-between flex-wrap">
            <div>
                <h5>FigureShop</h5>
                <p>Địa chỉ: 140, Lê Trọng Tấn, TP.HCM</p>
                <p>Điện thoại: 0909 000 111</p>
                <p>Email: contact@figureshop.vn</p>
            </div>
            <div class="align-self-end copy">© 2025 FigureShop. All rights reserved.</div>
        </div>
    </footer>

    <!-- FOOTER -->
    @RenderSection("Scripts", required: false)
    
</body>
</html>