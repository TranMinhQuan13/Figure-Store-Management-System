
@{
    ViewBag.Title = "GioiThieu";
    Layout = "~/Views/Shared/_LayoutPageBH.cshtml";
}








<style>
    :root {
        --primary: #ff7b72;
        --accent: #bb86fc;
        --dark: #1a1a2e;
        --light: #f8f9fa;
        --text: #333;
    }

    .about-section {
        padding: 80px 0;
        background: linear-gradient(to bottom, #fff, var(--light));
    }

    .about-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .about-header h1 {
            font-size: 48px;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 20px;
        }

        .about-header p {
            font-size: 20px;
            color: #666;
            max-width: 800px;
            margin: 0 auto;
        }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        margin: 60px 0;
    }

    .feature-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.3s;
    }

        .feature-card:hover {
            transform: translateY(-10px);
        }

    .feature-icon {
        font-size: 60px;
        color: var(--primary);
        margin-bottom: 20px;
    }

    .feature-card h3 {
        font-size: 24px;
        color: var(--dark);
        margin-bottom: 15px;
    }

    .feature-card p {
        color: #666;
        line-height: 1.7;
    }

    .team-section {
        background: var(--dark);
        color: white;
        padding: 80px 0;
        text-align: center;
    }

        .team-section h2 {
            font-size: 40px;
            margin-bottom: 50px;
        }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
    }

    .team-member {
        background: rgba(255,255,255,0.1);
        padding: 30px;
        border-radius: 16px;
    }

    .team-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        margin: 0 auto 20px;
        border: 5px solid var(--primary);
    }

        .team-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .team-member h4 {
        font-size: 22px;
        margin-bottom: 10px;
    }

    .team-member p {
        opacity: 0.9;
    }

    .cta-section {
        text-align: center;
        padding: 80px 0;
    }

        .cta-section h2 {
            font-size: 36px;
            margin-bottom: 20px;
        }

    .btn-cta {
        background: var(--primary);
        color: white;
        padding: 15px 40px;
        border-radius: 50px;
        font-size: 18px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
    }

        .btn-cta:hover {
            background: #ff5e52;
            transform: scale(1.05);
        }

    .about-header h1 {
        font-size: 36px;
    }

    .about-header p {
        font-size: 18px;
    }

    .feature-card {
        padding: 30px;
    }

    .team-section h2 {
        font-size: 32px;
    }
</style>



<!-- About Section -->
<section class="about-section">
    <div class="container">
        <div class="about-header">
            <h1>Chào mừng đến với FigureShop</h1>
            <p>FigureShop là cửa hàng trực tuyến chuyên cung cấp các mô hình figure, Gundam, Nendoroid, statue cao cấp chính hãng từ các thương hiệu nổi tiếng như Good Smile Company, Bandai, Kotobukiya...</p>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-shipping-fast"></i></div>
                <h3>Giao hàng nhanh chóng</h3>
                <p>Giao hàng toàn quốc trong 1-3 ngày, miễn phí nội thành TP.HCM với đơn từ 1.000.000đ.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                <h3>Sản phẩm chính hãng 100%</h3>
                <p>Cam kết figure chính hãng, đầy đủ hộp, phụ kiện, có tem chống giả từ nhà sản xuất.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-headset"></i></div>
                <h3>Hỗ trợ 24/7</h3>
                <p>Đội ngũ tư vấn nhiệt tình, sẵn sàng giải đáp mọi thắc mắc về figure và pre-order.</p>
            </div>
        </div>

        <div class="about-header">
            <p style="font-size:22px; max-width:900px; margin:0 auto; line-height:1.8;">
                Chúng tôi hiểu niềm đam mê sưu tầm của các collector. Mỗi mô hình figure không chỉ là sản phẩm, mà còn là tác phẩm nghệ thuật, là kỷ niệm, là niềm vui khi được trưng bày trên kệ Detolf lung linh.<br><br>
                FigureShop ra đời với sứ mệnh mang đến cho bạn những figure đẹp nhất, chất lượng nhất với giá tốt nhất!
            </p>
        </div>
    </div>
    <h2>Bắt đầu hành trình sưu tầm ngay hôm nay!</h2>
    <a href="@Url.Action("TrangChu", "BanHang")" class="btn-cta">Khám phá sản phẩm</a>
</section>









