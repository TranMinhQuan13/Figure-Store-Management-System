@model List<DoAnQLFIGURE.Models.GioHang>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPageBH.cshtml";
}

<style>
    :root {
        --rose: #c98682; /* màu hồng gạch cho nút */
        --header: #eaf0ff; /* nền đầu bảng/sum */
    }

    .table thead th {
        background: var(--header);
    }

    .qty-box {
        display: inline-flex;
        align-items: center;
        flex-wrap: nowrap; /* Quan trọng: không cho phép xuống dòng */
        white-space: nowrap;
    }

    .qty-btn {
        border: 0;
        padding: .45rem .7rem;
        background: var(--rose);
        color: #fff;
        line-height: 1;
        border-radius: .35rem;
    }

    .qty-input {
        width: 48px;
        text-align: center;
        border: 1px solid #dee2e6;
        margin: 0 .4rem;
        border-radius: .35rem;
        padding: .35rem 0;
        background: #eef2ff;
    }

    .btn-remove {
        background: var(--rose);
        color: #fff;
        border: 0;
        width: 36px;
        height: 36px;
        border-radius: .35rem;
    }

    .summary-title {
        background: var(--header);
        padding: .9rem 1rem;
        border-top-left-radius: .5rem;
        border-top-right-radius: .5rem;
    }

    .btn-checkout {
        background: var(--rose);
        color: #fff;
        border: 0;
        width: 100%;
        padding: 1rem;
        border-radius: .35rem;
    }

    .coupon-btn {
        background: var(--rose);
        color: #fff;
        border: 0;
    }
</style>

<!-- Cart Start -->
<div class="container my-4">
    <div class="row g-4">
        <!-- CART TABLE -->
        <h3>Thông tin giỏ hàng đã chọn</h3>
        <div class="col-lg-9">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-center">
                            <th class="text-start">Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody id="cart-body">
                        <!-- item -->
                        @foreach (var item in Model)
                        {
                            <tr data-price="150">
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="~/Content/Hinh/@item.Anh" class="rounded w-50" alt="">
                                        <div>@item.TenFigure</div>
                                    </div>
                                </td>
                                <td class="text-center">VNĐ<span class="unit">@string.Format("{0:#,###}", item.GiaBan)</span></td>
                                <td class="text-center">
                                    <div class="qty-box">
                                        @using (Html.BeginForm("CapNhatGioHang", "GioHang", FormMethod.Post))
                                        {
                                            <input type="hidden" name="ms" value="@item.MaFigure" />
                                            <button class="qty-btn minus" name="action" value="minus">−</button>
                                            <input type="text" class="qty-input" name="soluong" value="@item.SoLuong" inputmode="numeric">
                                            <button class="qty-btn plus" name="action" value="plus">+</button>
                                        }

                                    </div>
                                </td>
                                <td class="text-center">VNĐ<span class="row-total">@string.Format("{0:#,###}", item.ThanhTien)</span></td>

                                <td class="text-center">
                                    @using (Html.BeginForm("XoaGioHang", "GioHang", FormMethod.Post))
                                    {
                                        <input type="hidden" name="ms" value="@item.MaFigure" />
                                        <button class="btn-remove">&times;</button>
                                    }

                                </td>
                            </tr>
                        }


                        <!-- /item -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- COUPON + SUMMARY -->
        <div class="col-lg-3">
            <div class="border rounded">
                <div class="summary-title"><h5 class="m-0 fw-bold">Thông tin đơn hàng</h5></div>
                <div class="p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tổng cộng</span><strong>VNĐ<span id="subtotal">@string.Format("{0:#,###}", ViewBag.TongThanhTien)</span></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển</span><strong>VNĐ<span id="shipping">@string.Format("{0:#,###}", 10000)</span></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 d-none" id="discount-row">
                        <span>Giảm giá</span><strong>−VNĐ<span id="discount"></span>0</strong>
                    </div>
                    <hr>
                    <div class=" justify-content-between">
                        <strong>Tổng thành tiền:</strong><br /><strong>VND <span id="grand">@string.Format("{0:#,###}", ViewBag.TongThanhTien + 10000)</span></strong>
                    </div>
                    <div class="mt-3">
                        @using (Html.BeginForm("ChiTietThanhToan", "ThanhToan", FormMethod.Post))
                        {
                            <button class="btn-checkout">Thanh toán</button>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

